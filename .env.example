# Copy to .env for local development. Never commit the resulting .env file.
# See docs/SECURITY.md for secret handling rules.

NODE_ENV=development

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (local development only) ---
# docker-compose.dev.yml provisions a database with these values.
# DATABASE_USER is the container's bootstrap superuser. A superuser bypasses Row-Level
# Security, so it is NOT representative of how the application connects in any deployed
# environment. See database/README.md.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=threeddet_dev
DATABASE_USER=threeddet_dev
DATABASE_PASSWORD=change_me_locally
DATABASE_SSL=false

# --- Redis (background jobs, local development only) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Object storage (S3-compatible) ---
# Leave blank locally until an endpoint is provisioned.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# --- AI providers ---
# Supplied through the secret manager in deployed environments. Never commit real values.
AI_DEFAULT_PROVIDER=
AI_PROVIDER_API_KEY=
